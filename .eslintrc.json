{
  "env": {
    "browser": false,
    "node": true,
    "jest": true
  },
  "plugins": ["jest"],
  "extends": ["airbnb-base"],
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "rules": {
    "no-console": "off",
    "jest/no-disabled-tests": "warn",
    "jest/no-focused-tests": "error",
    "jest/no-identical-title": "error",
    "jest/prefer-to-have-length": "warn",
    "jest/valid-expect": "error",
    "max-classes-per-file": "off",
    "class-methods-use-this": "off",
    "max-len": "off",
    "arrow-parens": "off"
  }
}
