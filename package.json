{
  "name": "basm-move-generator",
  "version": "0.0.1",
  "license": "MIT",
  "scripts": {
    "husky": "husky init",
    "start": "node index.js",
    "build": "npm run setup",
    "lint": "eslint . --cache --max-warnings 0",
    "format": "npm run lint -- --fix",
    "verify": "npm run lint && npm run test",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "setup": "npm ci --no-audit && hmpps-npm-script-run-allowlist",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ministryofjustice/basm-move-generator"
  },
  "engines": {
    "node": "^22.9.0",
    "npm": "^11.2.0"
  },
  "dependencies": {
    "@faker-js/faker": "^9.4.0",
    "@ministryofjustice/hmpps-npm-script-allowlist": "0.0.3",
    "axios": "^1.13.5",
    "chalk": "^5.6.2",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.0",
    "enquirer": "^2.3.6",
    "jsona": "^1.9.7",
    "morgan": "^1.10.1",
    "nunjucks": "^3.2.4",
    "prompts": "^2.4.2",
    "uuid": "^11.0.5",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "@babel/traverse": "^7.28.3",
    "@ministryofjustice/eslint-config-hmpps": "^0.0.1",
    "babel-eslint": "^10.1.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.2.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2"
  }
}
