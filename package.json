{
  "name": "basm-move-generator",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "postinstall": "husky install",
    "start": "node index.js",
    "build": "npm ci --no-audit",
    "lint": "eslint . --cache --max-warnings 0",
    "format": "npm run lint -- --fix",
    "verify": "npm run lint && npm run test",
    "test": "jest",
    "test:ci": "jest --runInBand"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ministryofjustice/basm-move-generator"
  },
  "engines": {
    "node": "^22.9.0",
    "npm": "^11.2.0"
  },
  "dependencies": {
    "@faker-js/faker": "^9.4.0",
    "axios": "^1.11.0",
    "chalk": "^5.6.2",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.0",
    "enquirer": "^2.3.6",
    "eslint-plugin-jest": "^28.1.4",
    "jsona": "^1.9.7",
    "morgan": "^1.10.1",
    "nunjucks": "^3.2.4",
    "prompts": "^2.4.2",
    "uuid": "^11.0.5",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "@babel/traverse": "^7.28.3",
    "babel-eslint": "^10.1.0",
    "eslint": "^8.14.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.26.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.2.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2"
  }
}
