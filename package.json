{
  "name": "basm-move-generator",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "postinstall": "husky install",
    "start": "node --trace-warnings index.js",
    "lint": "eslint . --cache --max-warnings 0",
    "prettier": "prettier \"**/*.+(js|jsx|json|css|scss|md)\"",
    "verify": "npm run lint && npm run prettier -- --list-different && npm run test",
    "format": "npm run prettier -- --write",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ministryofjustice/basm-move-generator"
  },
  "engines": {
    "node": ">= 14",
    "npm": ">=6.14.8"
  },
  "dependencies": {
    "axios": "0.21.1",
    "date-fns": "^2.23.0",
    "dotenv": "^10.0.0",
    "drupal-jsonapi-params": "^1.2.2",
    "eslint-plugin-jest": "^25.3.0",
    "faker": "^5.5.3",
    "jsona": "^1.9.2",
    "jsonwebtoken": "^8.5.1",
    "moment": "^2.29.1",
    "morgan": "^1.10.0",
    "nunjucks": "^3.2.3",
    "passport": "^0.4.1",
    "passport-azure-ad-oauth2": "0.0.4",
    "uuid": "^8.3.2",
    "winston": "^3.3.3"
  },
  "devDependencies": {
    "babel-eslint": "^10.1.0",
    "eslint": "^8.4.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.25.3",
    "husky": "^7.0.2",
    "jest": "^27.4.4",
    "lint-staged": "^11.1.2",
    "nodemon": "^2.0.12",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.3.2"
  }
}
